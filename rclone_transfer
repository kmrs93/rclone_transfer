#!/bin/bash

FILES=()
DEST=""
OPERATION=""
RUNMODE=""
LOGGING=1
LOGFILE="rclone.log"

# --- Ask for source files repeatedly ---
echo "Enter source files or directories one by one (wildcards allowed, e.g. *.txt)."
echo "Press ENTER on an empty line when done."
while true; do
  read -e -p "Source file: " FILE
  if [ -z "$FILE" ]; then
    break
  fi
  FILES+=("$FILE")
done

if [ ${#FILES[@]} -eq 0 ]; then
  echo "No source files selected. Exiting."
  exit 1
fi

# --- Review step ---
echo "--------------------------------------------------"
echo "You selected the following sources:"
for i in "${!FILES[@]}"; do
  echo "$((i+1))) ${FILES[$i]}"
done
echo "--------------------------------------------------"
read -p "Do you want to remove any file? Enter numbers separated by spaces, or press ENTER to keep all: " REMOVE

if [ -n "$REMOVE" ]; then
  NEWFILES=()
  for i in "${!FILES[@]}"; do
    if [[ ! " $REMOVE " =~ " $((i+1)) " ]]; then
      NEWFILES+=("${FILES[$i]}")
    fi
  done
  FILES=("${NEWFILES[@]}")
fi

if [ ${#FILES[@]} -eq 0 ]; then
  echo "No files left after removal. Exiting."
  exit 1
fi

# --- Ask for destination ---
read -e -p "Enter destination path (local or remote, e.g. /mnt/backup or gdrive:backup): " DEST

# --- Calculate total size of sources ---
echo "Calculating total size of selected sources..."
TOTAL_SIZE_BYTES=$(du -sb "${FILES[@]}" 2>/dev/null | awk '{sum+=$1} END {print sum}')
TOTAL_SIZE_HUMAN=$(du -ch "${FILES[@]}" 2>/dev/null | tail -n 1 | awk '{print $1}')

# --- Check free space at destination ---
FREE_SPACE_BYTES=0
FREE_SPACE_HUMAN=""

echo "Checking free space at destination..."
if [[ "$DEST" == *:* ]]; then
  REMOTE=$(echo "$DEST" | cut -d: -f1)
  ABOUT=$(rclone about "$REMOTE": 2>/dev/null)
  FREE_SPACE_BYTES=$(echo "$ABOUT" | grep "Free:" | awk '{print $2}')
  FREE_SPACE_HUMAN=$(echo "$ABOUT" | grep "Free:" | awk '{print $2" "$3}')
  echo "$ABOUT"
else
  FREE_SPACE_BYTES=$(df -Pk "$DEST" 2>/dev/null | awk 'NR==2 {print $4*1024}')
  FREE_SPACE_HUMAN=$(df -h "$DEST" 2>/dev/null | awk 'NR==2 {print $4}')
  echo "Free space: $FREE_SPACE_HUMAN"
fi

echo "--------------------------------------------------"
echo "Total size of sources: $TOTAL_SIZE_HUMAN"
echo "--------------------------------------------------"

if [ "$FREE_SPACE_BYTES" -ne 0 ] && [ "$TOTAL_SIZE_BYTES" -gt "$FREE_SPACE_BYTES" ]; then
  echo "WARNING: Total size of sources ($TOTAL_SIZE_HUMAN) exceeds free space at destination ($FREE_SPACE_HUMAN)."
  exit 1
fi

# --- Ask for operation ---
echo "Choose operation:"
echo "1) Copy"
echo "2) Move"
read -p "Enter choice [1-2]: " OPERATION

# --- Ask for run mode ---
echo "Choose how to run the transfer:"
echo "1) Foreground (normal)"
echo "2) Background - attached (logs visible)"
echo "3) Background - detached (no logs, disowned)"
read -p "Enter choice [1-3]: " RUNMODE

# --- Ask about logging ---
echo "Do you want to enable logging?"
echo "1) No logging"
echo "2) Log to file"
read -p "Enter choice [1-2]: " LOGGING

LOGFILE="rclone.log"
if [ "$LOGGING" -eq 2 ]; then
  read -e -i "$LOGFILE" -p "Enter log filename (default: rclone.log): " LOGFILE
fi

# --- Summary ---
echo "--------------------------------------------------"
echo "Sources:"
for f in "${FILES[@]}"; do echo "  - $f"; done
echo "Destination: $DEST"
echo "Operation: $( [ "$OPERATION" -eq 1 ] && echo Copy || echo Move )"
echo "Run mode: $RUNMODE"
if [ "$LOGGING" -eq 2 ]; then
  echo "Logging enabled: $LOGFILE"
else
  echo "Logging: Disabled"
fi
echo "--------------------------------------------------"

# --- Confirmation ---
read -p "Proceed? [Y/n]: " CONFIRM
CONFIRM=${CONFIRM:-Y}
if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
  echo "Cancelled."
  exit 0
fi

# Extra safety for move
if [ "$OPERATION" -eq 2 ]; then
  echo "WARNING: MOVE will DELETE source files after transfer."
  read -p "Are you absolutely sure? [y/N]: " MOVE_CONFIRM
  if [[ ! "$MOVE_CONFIRM" =~ ^[Yy]$ ]]; then
    echo "Move cancelled."
    exit 0
  fi
fi

# --- Execute each source separately ---
for f in "${FILES[@]}"; do
  if [ "$OPERATION" -eq 1 ]; then
    ACTION="copy"
  else
    ACTION="move"
  fi

  if [ "$LOGGING" -eq 2 ]; then
    CMD="rclone $ACTION \"$f\" \"$DEST\" --progress >> \"$LOGFILE\" 2>&1"
  else
    CMD="rclone $ACTION \"$f\" \"$DEST\" --progress"
  fi

  case $RUNMODE in
    1) eval $CMD ;;
    2) eval $CMD & echo "Running in background (attached). PID: $!" ;;
    3) nohup bash -c "$CMD" >/dev/null 2>&1 & disown; echo "Running in background (detached). PID: $!" ;;
    *) echo "Invalid run mode choice. Exiting." ;;
  esac
done

# --- Append summary to log ---
if [ "$LOGGING" -eq 2 ]; then
  {
    echo "--------------------------------------------------"
    echo "TRANSFER SUMMARY"
    for f in "${FILES[@]}"; do echo "  - $f"; done
    echo "Destination: $DEST"
    echo "Operation: $( [ "$OPERATION" -eq 1 ] && echo Copy || echo Move )"
    echo "Run mode: $RUNMODE"
    echo "Log file: $LOGFILE"
    echo "Timestamp: $(date)"
    echo "Total size: $TOTAL_SIZE_HUMAN"
    if [ -n "$FREE_SPACE_HUMAN" ]; then
      echo "Free space: $FREE_SPACE_HUMAN"
    fi
    echo "--------------------------------------------------"
  } >> "$LOGFILE"
fi
