#!/usr/bin/env python3
import os
import subprocess
import shutil
import sys
from datetime import datetime

def ask_sources():
    files = []
    print("Enter source files or directories one by one (wildcards allowed, e.g. *.txt).")
    print("Press ENTER on an empty line when done.")
    while True:
        try:
            f = input("Source file: ").strip()
        except EOFError:
            break
        if not f:
            break
        files.append(f)
    if not files:
        print("No source files selected. Exiting.")
        sys.exit(1)
    return files

def review_sources(files):
    print("--------------------------------------------------")
    print("You selected the following sources:")
    for i, f in enumerate(files, 1):
        print(f"{i}) {f}")
    print("--------------------------------------------------")
    remove = input("Do you want to remove any file? Enter numbers separated by spaces, or press ENTER to keep all: ").strip()
    if remove:
        remove_set = set(remove.split())
        newfiles = [f for i, f in enumerate(files, 1) if str(i) not in remove_set]
        files = newfiles
    if not files:
        print("No files left after removal. Exiting.")
        sys.exit(1)
    return files

def calc_size(files):
    print("Calculating total size of selected sources...")
    try:
        du_out = subprocess.check_output(["du", "-sb"] + files, stderr=subprocess.DEVNULL).decode()
        total_bytes = sum(int(line.split()[0]) for line in du_out.splitlines())
    except Exception:
        total_bytes = 0
    try:
        du_out = subprocess.check_output(["du", "-ch"] + files, stderr=subprocess.DEVNULL).decode()
        total_human = du_out.strip().splitlines()[-1].split()[0]
    except Exception:
        total_human = "unknown"
    return total_bytes, total_human

def check_free_space(dest, total_bytes):
    free_bytes = 0
    free_human = ""
    print("Checking free space at destination...")
    if ":" in dest:  # remote
        remote = dest.split(":")[0]
        try:
            about = subprocess.check_output(["rclone", "about", f"{remote}:"], stderr=subprocess.DEVNULL).decode()
            for line in about.splitlines():
                if "Free:" in line:
                    parts = line.split()
                    free_human = " ".join(parts[1:])
                    try:
                        free_bytes = int(parts[1])
                    except Exception:
                        free_bytes = 0
            print(about)
        except Exception:
            print("Could not determine remote free space.")
    else:  # local
        try:
            stat = shutil.disk_usage(dest)
            free_bytes = stat.free
            free_human = f"{free_bytes // (1024*1024)}M"
            print(f"Free space: {free_human}")
        except Exception:
            print("Could not determine local free space.")
    if free_bytes and total_bytes > free_bytes:
        print(f"WARNING: Total size of sources exceeds free space at destination ({free_human}).")
        sys.exit(1)
    return free_bytes, free_human

def ask_operation():
    print("Choose operation:")
    print("1) Copy")
    print("2) Move")
    choice = input("Enter choice [1-2]: ").strip()
    if choice == "1":
        return "copy"
    elif choice == "2":
        return "move"
    else:
        print("Invalid choice. Exiting.")
        sys.exit(1)

def ask_runmode():
    print("Choose how to run the transfer:")
    print("1) Foreground (normal)")
    print("2) Background - attached (logs visible)")
    print("3) Background - detached (no logs, disowned)")
    choice = input("Enter choice [1-3]: ").strip()
    return choice

def ask_logging():
    print("Do you want to enable logging?")
    print("1) No logging")
    print("2) Log to file")
    choice = input("Enter choice [1-2]: ").strip()
    logfile = "rclone.log"
    if choice == "2":
        logfile = input(f"Enter log filename (default: {logfile}): ").strip() or logfile
    return int(choice), logfile

def summary(files, dest, operation, runmode, logging, logfile, total_human, free_human):
    print("--------------------------------------------------")
    print("Sources:")
    for f in files:
        print(f"  - {f}")
    print(f"Destination: {dest}")
    print(f"Operation: {operation.capitalize()}")
    print(f"Run mode: {runmode}")
    if logging == 2:
        print(f"Logging enabled: {logfile}")
    else:
        print("Logging: Disabled")
    print("--------------------------------------------------")
    print(f"Total size of sources: {total_human}")
    if free_human:
        print(f"Free space: {free_human}")
    print("--------------------------------------------------")

def execute(files, dest, operation, runmode, logging, logfile):
    confirm = input("Proceed? [Y/n]: ").strip() or "Y"
    if confirm.lower() != "y":
        print("Cancelled.")
        sys.exit(0)
    if operation == "move":
        move_confirm = input("WARNING: MOVE will DELETE source files after transfer. Are you absolutely sure? [y/N]: ").strip()
        if move_confirm.lower() != "y":
            print("Move cancelled.")
            sys.exit(0)

    for f in files:
        cmd = ["rclone", operation, f, dest, "--progress"]
        if logging == 2:
            with open(logfile, "a") as lf:
                lf.write(f"\n--- Transfer started for {f} at {datetime.now()} ---\n")
            if runmode == "1":
                subprocess.call(cmd, stdout=open(logfile, "a"), stderr=subprocess.STDOUT)
            elif runmode == "2":
                p = subprocess.Popen(cmd, stdout=open(logfile, "a"), stderr=subprocess.STDOUT)
                print(f"Running in background (attached). PID: {p.pid}")
            elif runmode == "3":
                subprocess.Popen(cmd, stdout=open(logfile, "a"), stderr=subprocess.STDOUT)
                print("Running in background (detached).")
        else:
            if runmode == "1":
                subprocess.call(cmd)
            elif runmode == "2":
                p = subprocess.Popen(cmd)
                print(f"Running in background (attached). PID: {p.pid}")
            elif runmode == "3":
                subprocess.Popen(cmd)
                print("Running in background (detached).")

def main():
    files = ask_sources()
    files = review_sources(files)
    dest = input("Enter destination path (local or remote, e.g. /mnt/backup or gdrive:backup): ").strip()
    total_bytes, total_human = calc_size(files)
    free_bytes, free_human = check_free_space(dest, total_bytes)
    operation = ask_operation()
    runmode = ask_runmode()
    logging, logfile = ask_logging()
    summary(files, dest, operation, runmode, logging, logfile, total_human, free_human)
    execute(files, dest, operation, runmode, logging, logfile)

if __name__ == "__main__":
    main()
